ARG version=0.0.0

# The static binary is cross-compiled on the host with cross-rs, so this image
# only packages it. Build first with:
#   cross build --release --bin kickable --all-features --locked \
#     --target aarch64-unknown-linux-musl
# (musl is used for a fully static binary that runs in scratch.)
FROM scratch AS kickable
ARG version

COPY target/aarch64-unknown-linux-musl/release/kickable /usr/local/bin/kickable
COPY kickable.yaml /etc/kickable/config

USER 1000
ENTRYPOINT ["/usr/local/bin/kickable"]

LABEL description="kickable (aarch64-unknown-linux-musl) — Can you kick it?"
LABEL maintainer="Hector Gray <hector@hectorgray.com>"
LABEL version=$version
