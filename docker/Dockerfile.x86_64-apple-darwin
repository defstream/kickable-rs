ARG version=0.0.0

# Artifact image only. macOS binaries cannot execute in a Linux container, so
# this image carries the cross-built binary for distribution extraction.
# cross-rs has no Docker image for Apple targets; `cross build` transparently
# falls back to host cargo (run on a macOS host with the target installed):
#   cross build --release --bin kickable --all-features --locked \
#     --target x86_64-apple-darwin
FROM scratch
ARG version

COPY target/x86_64-apple-darwin/release/kickable /dist/kickable
COPY kickable.yaml /dist/kickable.yaml

LABEL description="kickable (x86_64-apple-darwin) build artifact — Can you kick it?"
LABEL maintainer="Hector Gray <hector@hectorgray.com>"
LABEL version=$version
