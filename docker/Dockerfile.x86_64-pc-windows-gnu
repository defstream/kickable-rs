ARG version=0.0.0

# Artifact image only. Windows binaries cannot execute in a Linux container, so
# this image carries the cross-built .exe for distribution extraction.
# cross-rs provides a Windows GNU image; build with:
#   cross build --release --bin kickable --all-features --locked \
#     --target x86_64-pc-windows-gnu
FROM scratch
ARG version

COPY target/x86_64-pc-windows-gnu/release/kickable.exe /dist/kickable.exe
COPY kickable.yaml /dist/kickable.yaml

LABEL description="kickable (x86_64-pc-windows-gnu) build artifact — Can you kick it?"
LABEL maintainer="Hector Gray <hector@hectorgray.com>"
LABEL version=$version
